{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edecode",
  "compatibility_date": "2026-08-01",
  "main": "./worker/index.ts",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/chat", "/api/debug-env"]
  }
}
